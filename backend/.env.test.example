# Create two confirmed, dedicated test accounts in the configured Supabase project.
# Copy this file to backend/.env.test.local (ignored by Git).
# The URL and public key are read from frontend/.env.local.
SUPABASE_TEST_EMAIL_A=
SUPABASE_TEST_PASSWORD_A=
SUPABASE_TEST_EMAIL_B=
SUPABASE_TEST_PASSWORD_B=
